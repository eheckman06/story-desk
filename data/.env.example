# Copy to data/.env and fill in values.

# Slack (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Airtable — Fox article performance
# 1. Create token: https://airtable.com/create/tokens
#    Scopes: data.records:read, schema.bases:read
#    Access: base appbfEwPkkvJmE7l7
# 2. Run: python3 scripts/sync_airtable.py --list-tables
# 3. Set AIRTABLE_TABLE_NAME, then: python3 scripts/sync_airtable.py --sync
AIRTABLE_TOKEN=patYOUR_TOKEN_HERE
AIRTABLE_BASE_ID=appbfEwPkkvJmE7l7
AIRTABLE_TABLE_NAME=
AIRTABLE_VIEW_NAME=
